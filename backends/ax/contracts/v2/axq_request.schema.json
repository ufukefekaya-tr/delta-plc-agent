{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/axq-request.schema.json",
  "title": "AXQ-FILE/2 Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_type",
    "correlation_id",
    "job_id",
    "operation",
    "created_at",
    "deadline_at",
    "environment_digest",
    "workspace_digest",
    "expected_revision",
    "authorization_digest",
    "artifacts"
  ],
  "properties": {
    "protocol": {
      "const": "AXQ-FILE/2"
    },
    "message_type": {
      "const": "request"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "deadline_at": {
      "$ref": "#/$defs/timestamp"
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "workspace_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "authorization_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "deployment.execute"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "authorization_digest": {
            "$ref": "#/$defs/digest"
          },
          "artifacts": {
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "authorization"
                }
              },
              "required": [
                "role"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "operation": {
      "enum": [
        "environment.probe",
        "project.tree.read",
        "project.inventory.read",
        "source.read",
        "project.export.native",
        "workspace.create",
        "workspace.status",
        "source.upsert.st",
        "ladder.networks.apply",
        "project.build",
        "artifact.freeze",
        "deployment.prepare",
        "deployment.execute",
        "deployment.reconcile",
        "target.observe.start",
        "target.observe.read",
        "target.observe.stop",
        "job.status",
        "job.cancel"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "input",
            "output",
            "project",
            "source",
            "recipe",
            "authorization",
            "observation",
            "evidence"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
