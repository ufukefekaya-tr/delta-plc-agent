{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/environment-identity-v1.schema.json",
  "title": "EnvironmentIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "captured_at",
    "executable",
    "profile",
    "product",
    "script_engine",
    "target",
    "devices",
    "libraries",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "EnvironmentIdentity"
    },
    "captured_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "executable": {
      "$ref": "#/$defs/identity"
    },
    "profile": {
      "$ref": "#/$defs/identity"
    },
    "product": {
      "$ref": "#/$defs/identity"
    },
    "script_engine": {
      "$ref": "#/$defs/identity"
    },
    "target": {
      "$ref": "#/$defs/identity"
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "uniqueItems": true
    },
    "libraries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
