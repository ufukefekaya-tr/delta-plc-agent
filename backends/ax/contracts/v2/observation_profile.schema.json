{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/observation-profile.schema.json",
  "title": "ObservationProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "profile_id",
    "expressions",
    "interval_ms",
    "duration_seconds",
    "fault_invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "ObservationProfile"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "expressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,127}$"
      }
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "fault_invariants": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "operator",
        "expected",
        "action"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,127}$"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge"
          ]
        },
        "expected": {
          "type": [
            "boolean",
            "integer",
            "number",
            "string"
          ]
        },
        "action": {
          "enum": [
            "record",
            "stop_and_rollback"
          ]
        }
      }
    }
  }
}
