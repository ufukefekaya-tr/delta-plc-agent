{
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/axq-result.schema.json",
  "additionalProperties": false,
  "type": "object",
  "title": "AXQ-FILE/2 Result",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "source",
        "line",
        "column"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "enum": [
        "environment.probe",
        "project.tree.read",
        "project.inventory.read",
        "source.read",
        "project.export.native",
        "workspace.create",
        "workspace.status",
        "source.upsert.st",
        "ladder.networks.apply",
        "revision.apply",
        "candidate.snapshot",
        "project.build",
        "artifact.freeze",
        "deployment.prepare",
        "deployment.execute",
        "deployment.reconcile",
        "target.observe.start",
        "target.observe.read",
        "target.observe.stop",
        "job.status",
        "job.cancel"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "protocol": {
      "const": "AXQ-FILE/2"
    },
    "message_type": {
      "const": "result"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "blocked",
        "failed",
        "cancelled",
        "unknown_outcome"
      ]
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "workspace_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "before_project_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_project_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "protocol",
    "message_type",
    "correlation_id",
    "job_id",
    "operation",
    "created_at",
    "status",
    "environment_digest",
    "workspace_digest",
    "request_digest",
    "before_project_digest",
    "after_project_digest",
    "revision",
    "artifacts",
    "diagnostics"
  ]
}
