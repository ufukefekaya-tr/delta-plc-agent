{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/job-result.schema.json",
  "title": "JobResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "job_id",
    "correlation_id",
    "operation",
    "status",
    "created_at",
    "started_at",
    "completed_at",
    "result_digest",
    "evidence_digest",
    "unknown_outcome",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "JobResult"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "blocked",
        "failed",
        "cancelled",
        "unknown_outcome"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "started_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "unknown_outcome": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "operation": {
      "enum": [
        "environment.probe",
        "project.tree.read",
        "project.inventory.read",
        "source.read",
        "project.export.native",
        "workspace.create",
        "workspace.status",
        "source.upsert.st",
        "ladder.networks.apply",
        "project.build",
        "artifact.freeze",
        "deployment.prepare",
        "deployment.execute",
        "deployment.reconcile",
        "target.observe.start",
        "target.observe.read",
        "target.observe.stop",
        "job.status",
        "job.cancel"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
