{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/evidence-record-v1.schema.json",
  "title": "EvidenceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "created_at",
    "correlation_id",
    "producer",
    "evidence_class",
    "input_digest",
    "output_digest",
    "environment_digest",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "EvidenceRecord"
    },
    "created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producer": {
      "enum": [
        "agent",
        "human"
      ]
    },
    "evidence_class": {
      "enum": [
        "CLAIM",
        "SOURCE_REVIEWED",
        "STATIC_CHECKED",
        "SIMULATED",
        "HUMAN_IDE_COMPILED",
        "HUMAN_BENCH_VERIFIED",
        "HUMAN_FAT_ACCEPTED"
      ]
    },
    "input_digest": {
      "$ref": "#/$defs/digest"
    },
    "output_digest": {
      "$ref": "#/$defs/digest"
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
