{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/workspace-handle.schema.json",
  "title": "WorkspaceHandle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "workspace_id",
    "created_at",
    "baseline_project_digest",
    "current_project_digest",
    "environment_digest",
    "revision",
    "dirty",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "WorkspaceHandle"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "baseline_project_digest": {
      "$ref": "#/$defs/digest"
    },
    "current_project_digest": {
      "$ref": "#/$defs/digest"
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "dirty": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "active",
        "frozen",
        "blocked"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
