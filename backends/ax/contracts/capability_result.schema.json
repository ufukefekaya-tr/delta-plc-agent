{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/capability-result-v1.schema.json",
  "title": "CapabilityResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "captured_at",
    "operation",
    "status",
    "mode",
    "limitations",
    "environment_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "CapabilityResult"
    },
    "captured_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "operation": {
      "enum": [
        "environment.probe",
        "project.tree.read",
        "project.inventory.read",
        "source.read",
        "project.export.native"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "unverified",
        "blocked"
      ]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
