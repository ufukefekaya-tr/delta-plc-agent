{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/ax/contracts/v2/job_progress.schema.json",
  "title": "JobProgress v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "job_id", "operation", "status", "transport_profile", "stage", "observed_at", "elapsed_seconds", "remaining_seconds", "budget_scope", "status_interval_seconds", "warning", "last_real_progress", "source", "uncertainty", "bytes_transferred", "bytes_total", "percent"],
  "properties": {
    "schema_version": {"const": "1"},
    "record_type": {"const": "JobProgress"},
    "job_id": {"type": "string", "format": "uuid"},
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "running", "succeeded", "blocked", "failed", "cancelled", "unknown_outcome"]},
    "transport_profile": {"enum": ["lan", "diacloud"]},
    "stage": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "elapsed_seconds": {"type": "integer", "minimum": 0},
    "remaining_seconds": {"type": "integer", "minimum": 0},
    "budget_scope": {"enum": ["workflow", "watch", "rollback"]},
    "status_interval_seconds": {"const": 30},
    "warning": {"type": "boolean"},
    "last_real_progress": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["event", "observed_at", "source"], "properties": {"event": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "source": {"enum": ["build_transaction", "deployment_journal"]}}}]},
    "source": {"enum": ["queue", "build_transaction", "deployment_journal"]},
    "uncertainty": {"type": "boolean"},
    "bytes_transferred": {"type": "null"},
    "bytes_total": {"type": "null"},
    "percent": {"type": "null"}
  }
}
