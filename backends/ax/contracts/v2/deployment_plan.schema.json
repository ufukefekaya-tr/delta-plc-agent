{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/deployment-plan.schema.json",
  "title": "DeploymentPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "plan_id",
    "created_at",
    "expires_at",
    "valid_for_seconds",
    "artifact_digest",
    "build_digest",
    "runtime_release_digest",
    "target_fingerprint",
    "rollback_digest",
    "rollback_runtime_release_digest",
    "observation_digest",
    "challenge_nonce",
    "authority_digest",
    "one_shot",
    "state",
    "reconciliation_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "DeploymentPlan"
    },
    "plan_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_for_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "build_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_release_digest": {
      "$ref": "#/$defs/digest"
    },
    "target_fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "rollback_digest": {
      "$ref": "#/$defs/digest"
    },
    "rollback_runtime_release_digest": {
      "$ref": "#/$defs/digest"
    },
    "observation_digest": {
      "$ref": "#/$defs/digest"
    },
    "challenge_nonce": {
      "$ref": "#/$defs/uuid"
    },
    "authority_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "one_shot": {
      "const": true
    },
    "state": {
      "enum": [
        "prepared",
        "authorized",
        "executing",
        "observing",
        "succeeded",
        "rolled_back",
        "blocked",
        "failed",
        "unknown_outcome",
        "expired",
        "consumed"
      ]
    },
    "reconciliation_required": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "prepared"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "authority_digest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "authorized",
              "executing",
              "observing",
              "succeeded",
              "rolled_back",
              "unknown_outcome",
              "consumed"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "authority_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  ],
  "x-invariants": [
    "expires_at must equal created_at plus valid_for_seconds",
    "authority_digest must bind plan_id, artifact_digest, target_fingerprint, rollback_digest, both runtime release digests, observation_digest, challenge_nonce, expires_at and the exact authority phrase digest"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
