{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-plc.invalid/mcp-foundation/contracts/v2/ladder-recipe-v2.schema.json",
  "title": "LadderRecipe v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "project",
    "pou",
    "variables",
    "networks",
    "output_allowlist"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "record_type": {
      "const": "LadderRecipe"
    },
    "project": {
      "$ref": "#/$defs/identifier"
    },
    "pou": {
      "$ref": "#/$defs/identifier"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "output_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "direction",
        "comment"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "BOOL",
            "TIME"
          ]
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "local"
          ]
        },
        "comment": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "comment",
        "elements",
        "coil"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "comment": {
          "$ref": "#/$defs/nonempty"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "coil": {
          "$ref": "#/$defs/coil"
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/contact"
        },
        {
          "$ref": "#/$defs/branch"
        },
        {
          "$ref": "#/$defs/fbCall"
        }
      ]
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "variable",
        "polarity"
      ],
      "properties": {
        "kind": {
          "const": "contact"
        },
        "variable": {
          "$ref": "#/$defs/identifier"
        },
        "polarity": {
          "enum": [
            "NO",
            "NC"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "paths"
      ],
      "properties": {
        "kind": {
          "const": "branch"
        },
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/contact"
            }
          }
        }
      }
    },
    "fbCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "block_type",
        "instance",
        "inputs",
        "outputs"
      ],
      "properties": {
        "kind": {
          "const": "fb_call"
        },
        "block_type": {
          "enum": [
            "R_TRIG",
            "TON",
            "TP"
          ]
        },
        "instance": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/pinBinding"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/pinBinding"
          }
        }
      }
    },
    "pinBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin",
        "variable"
      ],
      "properties": {
        "pin": {
          "$ref": "#/$defs/identifier"
        },
        "variable": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "coil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "mode"
      ],
      "properties": {
        "variable": {
          "$ref": "#/$defs/identifier"
        },
        "mode": {
          "const": "normal"
        }
      }
    }
  }
}
